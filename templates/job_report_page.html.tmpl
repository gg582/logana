<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Logana Report {{ jobId }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans+KR:wght@400;500;600;700&family=Fira+Code:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
      :root {
        --bg: #f3ede2;
        --ink: #171311;
        --muted: #6f6254;
        --card: #fffaf1;
        --line: #d8c9b6;
        --accent: #c96c4b;
        --accent-2: #d9a441;
        --calm: #c6dfd2;
        --warm: #f1d9aa;
        --hot: #efc1ad;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background:
          radial-gradient(circle at top left, rgba(201, 108, 75, 0.18), transparent 24rem),
          radial-gradient(circle at bottom right, rgba(217, 164, 65, 0.16), transparent 28rem),
          var(--bg);
        color: var(--ink);
        font-family: "Space Grotesk", "IBM Plex Sans KR", "Noto Sans KR", sans-serif;
        line-height: 1.6;
      }
      .page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 24px 64px;
      }

      /* ---------- Topbar ---------- */
      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 32px;
      }
      .topbar h1 {
        margin: 0;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .topbar p {
        margin: 4px 0 0;
        color: var(--muted);
        font-size: 13px;
      }
      .chip {
        border: 1px solid var(--line);
        border-radius: 999px;
        background: rgba(255, 250, 241, 0.78);
        padding: 8px 16px;
        font-size: 13px;
        color: var(--muted);
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease;
      }
      .chip:hover {
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(23, 19, 17, 0.04);
      }

      /* ---------- Shell ---------- */
      .report-shell {
        display: grid;
        gap: 28px;
      }

      /* ---------- Hero ---------- */
      .report-hero {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 24px;
        padding: 32px;
        border-radius: 24px;
        border: 1px solid var(--line);
        background: var(--card);
        box-shadow: 0 1px 2px rgba(23, 19, 17, 0.04), 0 8px 24px rgba(23, 19, 17, 0.03);
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .report-hero:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(23, 19, 17, 0.06), 0 20px 48px rgba(23, 19, 17, 0.04);
      }
      .report-kicker {
        margin: 0 0 8px;
        color: var(--accent);
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        font-size: 12px;
      }
      .report-hero h1 {
        margin: 0;
        font-size: clamp(26px, 4vw, 40px);
        line-height: 1.15;
        font-weight: 700;
      }
      .report-copy {
        max-width: 50rem;
        margin: 12px 0 0;
        color: var(--muted);
        font-size: 15px;
        line-height: 1.65;
      }
      .report-badge {
        align-self: flex-start;
        flex-shrink: 0;
        border-radius: 999px;
        padding: 8px 18px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 700;
        border: 1px solid var(--line);
      }
      .report-badge-ready { background: var(--calm); }
      .report-badge-failed { background: var(--hot); }
      .report-badge-rendering,
      .report-badge-analyzing,
      .report-badge-batching,
      .report-badge-queued { background: var(--warm); }

      /* ---------- Metrics ---------- */
      .report-metrics {
        display: flex;
        gap: 0;
        align-items: stretch;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }
      .report-metrics article {
        flex: 1;
        min-width: 0;
        padding: 16px 20px;
        border-right: 1px solid var(--line);
        background: none;
        border-radius: 0;
        box-shadow: none;
        transition: background 0.35s ease;
      }
      .report-metrics article:hover {
        background: rgba(255, 250, 241, 0.5);
      }
      .report-metrics article:last-child {
        border-right: none;
      }
      .report-metrics span {
        display: block;
        color: var(--muted);
        font-size: 12px;
        margin-bottom: 6px;
        letter-spacing: 0.02em;
      }
      .report-metrics strong {
        font-size: 22px;
        font-weight: 700;
        color: var(--ink);
      }

      /* ---------- Grid ---------- */
      .report-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) minmax(300px, 0.9fr);
        gap: 24px;
        align-items: start;
      }

      /* ---------- Panel (single card, no nesting) ---------- */
      .report-panel {
        border-radius: 24px;
        padding: 28px;
        border: 1px solid var(--line);
        background: var(--card);
        box-shadow: 0 1px 2px rgba(23, 19, 17, 0.04), 0 8px 24px rgba(23, 19, 17, 0.03);
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .report-panel:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(23, 19, 17, 0.06), 0 20px 48px rgba(23, 19, 17, 0.04);
      }
      .report-panel-head {
        margin-bottom: 20px;
      }
      .report-panel-head h2 {
        margin: 0;
        font-size: 18px;
        font-weight: 700;
      }
      .report-panel-head p {
        margin: 6px 0 0;
        color: var(--muted);
        font-size: 14px;
      }
      .report-canvas {
        overflow: hidden;
        border-radius: 16px;
        border: 1px solid var(--line);
        background: #fff;
        transition: box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s ease;
      }
      .report-canvas:hover {
        box-shadow: 0 2px 8px rgba(23, 19, 17, 0.04);
        border-color: rgba(216, 201, 182, 0.8);
      }
      .report-canvas svg {
        display: block;
        width: 100%;
        height: auto;
      }

      /* ---------- Insights (table) ---------- */
      .report-insights {
        display: block;
      }
      .report-insights-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
      }
      .report-insights-table tr {
        border-bottom: 1px solid var(--line);
        transition: background 0.25s ease;
      }
      .report-insights-table tr:hover {
        background: rgba(255, 250, 241, 0.35);
      }
      .report-insights-table tr:last-child {
        border-bottom: none;
      }
      .report-insights-table th {
        width: 1%;
        white-space: nowrap;
        text-align: left;
        padding: 12px 16px;
        font-weight: 700;
        font-size: 14px;
        vertical-align: top;
      }
      .report-insights-table td {
        padding: 12px 16px;
        color: var(--muted);
        line-height: 1.6;
        vertical-align: top;
      }
      .report-insight-calm { background: rgba(198, 223, 210, 0.25); }
      .report-insight-warm { background: rgba(241, 217, 170, 0.28); }
      .report-insight-hot  { background: rgba(239, 193, 173, 0.30); }

      /* ---------- Error ---------- */
      .report-error {
        border: 1px solid #d39f92;
        background: rgba(239, 193, 173, 0.55);
        border-radius: 16px;
        padding: 18px 22px;
        font-size: 14px;
        color: #5a2e1e;
      }

      /* ---------- Responsive ---------- */
      @media (max-width: 980px) {
        .page { padding: 24px 16px 48px; }
        .report-metrics { flex-wrap: wrap; }
        .report-metrics article {
          flex: 1 1 30%;
          border-right: 1px solid var(--line);
          border-bottom: 1px solid var(--line);
        }
        .report-metrics article:nth-child(3n) { border-right: none; }
        .report-grid { grid-template-columns: 1fr; }
        .report-hero { flex-direction: column; }
      }
      @media (max-width: 560px) {
        .report-metrics article {
          flex: 1 1 45%;
        }
        .report-metrics article:nth-child(3n) { border-right: 1px solid var(--line); }
        .report-metrics article:nth-child(2n) { border-right: none; }
        .report-panel { padding: 20px; }
        .report-hero { padding: 24px; }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <header class="topbar">
        <div>
          <h1>Logana · Log Parser Engine</h1>
          <p>Job {{ jobId }} rendered on the C server.</p>
        </div>
        <div class="chip">status: {{ status }}</div>
      </header>
      {{ body }}
    </main>
  </body>
</html>
